{
  "name": "us-for-real-couple-wellness",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs",
    "frontend:policy": "node scripts/frontend-policy.mjs",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-us-for-real-therapy --only firestore \"node --test tests/firestore-rules.emulator.mjs\"",
    "test:e2e": "playwright test",
    "ci": "npm run build && npm run test:unit"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.6.0",
    "google-auth-library": "^10.9.0",
    "nodemailer": "^9.0.3"
  },
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
